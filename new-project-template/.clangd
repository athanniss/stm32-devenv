# clangd configuration for this project.
# Reference: https://clangd.llvm.org/config
# A file can hold several blocks separated by "---". A block with an "If:"
# section only applies to matching files; a block without one applies to all.
# clang-tidy checks are configured in .clang-tidy, not here.

# --- All files ----------------------------------------------------------------
# The project is compiled with GCC, but clangd parses it with Clang. Adjust the
# GCC command lines from compile_commands.json so Clang accepts them:
#   --specs=*                         GCC-only option (e.g. --specs=nano.specs)
#   -Wno-unknown-warning-option       ignore GCC-only -W options Clang lacks
#   -Wno-unused-command-line-argument ignore options Clang accepts but does
#                                     not use when only parsing
CompileFlags:
  Add:
    - -Wno-unknown-warning-option
    - -Wno-unused-command-line-argument
  Remove:
    - --specs=*

# Report #include lines that are not needed (clangd's default, written out so
# it is visible). ST's headers are excluded: the HAL is meant to be included
# through umbrella headers (main.h -> stm32xxxx_hal.h), which clangd cannot
# always trace, so it would report needed includes as unused.
# IgnoreHeader entries are regexes matched against the end of the header path.
# First draft: tune after testing with a real CubeMX project.
Diagnostics:
  UnusedIncludes: Strict
  Includes:
    IgnoreHeader:
      - stm32.*_hal.*\.h      # HAL headers, e.g. stm32f4xx_hal_gpio.h
      - stm32.*_ll_.*\.h      # LL headers, e.g. stm32f4xx_ll_gpio.h
      - stm32[a-z0-9]+xx\.h   # device family header, e.g. stm32f4xx.h
      - core_cm.*\.h          # CMSIS core, e.g. core_cm4.h
      - cmsis_.*\.h           # CMSIS compiler support, e.g. cmsis_gcc.h

# Do not add #include lines automatically when accepting a completion.
Completion:
  HeaderInsertion: Never

---
# --- Code generated by CubeMX ------------------------------------------------
# No warnings in folders CubeMX generates or copies in. Our own code lives in
# src/ and any other folder, which keep full warnings.
#   Core/         CubeMX-generated startup code; only minimal glue is ours
#   Drivers/      ST's HAL/LL drivers and CMSIS headers
#   Middlewares/  third-party libraries (FreeRTOS, USB, FatFs, ...)
# Paths are relative to the folder containing this file (the project root).
If:
  PathMatch: (Core|Drivers|Middlewares)/.*
Diagnostics:
  Suppress: '*'
