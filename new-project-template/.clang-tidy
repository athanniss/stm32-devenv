# clang-tidy configuration for this project (C code).
# Reference: https://clang.llvm.org/extra/clang-tidy/checks/list.html
#
# Used both by clangd in the editor and by clang-tidy / run-clang-tidy on the
# command line, so keep all check selection here (not in .clangd).
#
# Strategy: enable whole check families, then disable individual checks that
# are noise for embedded C. Each disabled check is listed below with the reason.
# Tune in the stm32-devenv template, not per project.
#
# Enabled families:
#   bugprone-*        real bug patterns (sizeof misuse, suspicious memset, ...)
#   cert-*            CERT C secure coding rules
#   clang-analyzer-*  Clang Static Analyzer (path-sensitive; slow, so clangd
#                     skips it in the editor; runs from the command line)
#   concurrency-*     functions that are not safe to call from several
#                     threads/ISRs (e.g. strtok, rand)
#   misc-*            mixed checks, e.g. misc-no-recursion
#   performance-*     mostly C++; for C e.g. sin() used where sinf() was meant
#   portability-*     non-portable constructs, e.g. #pragma once
#   readability-*     clarity and style
#   cppcoreguidelines-init-variables  every local variable is initialised
#   hicpp-signed-bitwise              bitwise operations on signed integers
#
# Disabled checks:
#   bugprone-easily-swappable-parameters  flags every function with two
#       parameters of the same type
#   bugprone-reserved-identifier (+ aliases cert-dcl37-c, cert-dcl51-cpp)
#       CMSIS-style code uses __ prefixed names
#   misc-include-cleaner  duplicates clangd's own include check (see .clangd)
#   performance-no-int-to-ptr  memory-mapped registers need integer-to-pointer
#       casts
#   readability-avoid-const-params-in-decls  const on parameters in
#       declarations is kept on purpose, to be explicit
#   readability-braces-around-statements  single-line ifs without braces are
#       allowed
#   readability-function-cognitive-complexity  noisy on hardware setup code
#   readability-identifier-length  flags short names such as i, n, x
#   readability-isolate-declaration  allows several declarations per line
#   readability-magic-numbers  flags every register value and bit mask
#   readability-simplify-boolean-expr  too opinionated about how boolean
#       expressions should be written
#   readability-uppercase-literal-suffix (+ alias cert-dcl16-c)  1u is fine
#   clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling
#       flags every memcpy/memset/sprintf and asks for Annex K *_s functions,
#       which newlib does not provide
#   clang-analyzer-core.FixedAddressDereference  flags every register access
#       (RCC->AHB4ENR, GPIOA->ODR, ...), since registers live at fixed addresses
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  misc-*,
  performance-*,
  portability-*,
  readability-*,
  cppcoreguidelines-init-variables,
  hicpp-signed-bitwise,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  -misc-include-cleaner,
  -performance-no-int-to-ptr,
  -readability-avoid-const-params-in-decls,
  -readability-braces-around-statements,
  -readability-function-cognitive-complexity,
  -readability-identifier-length,
  -readability-isolate-declaration,
  -readability-magic-numbers,
  -readability-simplify-boolean-expr,
  -readability-uppercase-literal-suffix,
  -cert-dcl16-c,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -clang-analyzer-core.FixedAddressDereference

# Also report warnings in our own headers (under src/). Warnings in CubeMX and
# HAL headers are not reported.
HeaderFilterRegex: '/src/'

# Do not reformat code when clang-tidy applies a fix. Change to "file" once the
# template has a .clang-format, so fixes follow the project's style.
FormatStyle: none
