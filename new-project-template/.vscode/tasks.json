// VS Code tasks for this project: Terminal > Run Task... (or any task runner).
// They run inside the dev container and analyse only our own code in src/.
// Building is done with CMake Tools (F7 or the Build button in the status bar).
// Problem matcher: each task defines its own, because VS Code's "$gcc" exists
// only with the C/C++ extension, which we don't install. It reads lines like
//   /path/file.c:12:5: warning: message
// "source" is the label shown after each entry in the Problems panel; type it
// in the panel's filter box to see one tool's findings only.
// autoDetect accepts absolute and relative paths. Tools must print no colour
// codes, or the lines don't match.
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run: clang-tidy (all files)",
      "detail": "clang-tidy on every file in src/, in parallel, including the static analyzer",
      "type": "shell",
      // -p .   compile_commands.json is in the project root
      // "/src/" regex: only files whose path contains /src/
      "command": "run-clang-tidy -p . -quiet '/src/'",
      "problemMatcher": {
        "owner": "clang-tidy",
        "source": "clang-tidy",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
        }
      },
      "presentation": { "clear": true }
    },
    {
      "label": "Run: clang-tidy (current file)",
      "detail": "clang-tidy on the file open in the editor, including the static analyzer",
      "type": "shell",
      // Only C files: on any other open file (e.g. this one) clang-tidy would
      // report it as broken C code.
      "command": "case '${file}' in *.c|*.h) clang-tidy -p . --use-color=false '${file}' ;; *) echo 'Not a .c or .h file: ${file}' ;; esac",
      "problemMatcher": {
        "owner": "clang-tidy",
        "source": "clang-tidy",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
        }
      },
      "presentation": { "clear": true }
    },
    {
      "label": "Run: cppcheck",
      "detail": "cppcheck on every file in src/",
      "type": "shell",
      // --platform        type sizes of 32-bit ARM, not of the host PC
      // --suppress        no findings located in HAL/CMSIS headers
      // --template        file:line:col: warning: ... without colour codes
      // --cppcheck-build-dir  cache, so unchanged files are not re-analysed
      "command": "mkdir -p build/cppcheck && cppcheck --project=compile_commands.json '--file-filter=*/src/*' --platform=arm32-wchar_t4 --enable=warning,style,performance,portability --inline-suppr '--suppress=*:*/Drivers/*' '--template={file}:{line}:{column}: warning: {message} [{severity}/{id}]' -q --cppcheck-build-dir=build/cppcheck",
      "problemMatcher": {
        "owner": "cppcheck",
        "source": "cppcheck",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
        }
      },
      "presentation": { "clear": true }
    },
    {
      "label": "Clean: build output",
      "detail": "Delete build/ (objects, ELF, CMake cache) and the copied compile_commands.json",
      "type": "shell",
      "command": "rm -rf build compile_commands.json",
      "problemMatcher": [],
      "presentation": { "clear": true }
    }
  ]
}
